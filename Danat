<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danat Mini App</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .card {
      background: white;
      width: 85%;
      max-width: 400px;
      padding: 35px 20px;
      border-radius: 25px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }

    h1 {
      font-size: 30px;
      margin-bottom: 20px;
    }

    p {
      font-size: 20px;
      color: #555;
    }

    button {
      margin-top: 20px;
      padding: 15px 45px;
      border: none;
      border-radius: 15px;
      background: #2196f3;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }

    button:active {
      transform: scale(0.95);
    }
  </style>
</head>

<body>

  <div class="card">
    <h1>🎁 Danat Mini App</h1>

    <p>Assalomu alaykum!</p>

    <button onclick="bosildi()">Bosish</button>

    <p id="natija"></p>
  </div>

  <script>
    function bosildi() {
      document.getElementById("natija").innerText =
        "🎉 Tugma bosildi! Xush kelibsiz!";
    }
  </script>

</body>
</html>
